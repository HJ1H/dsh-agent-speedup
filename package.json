{
  "name": "dsh-agent-speedup",
  "version": "0.3.0",
  "description": "Tool-execution efficiency suite for DeepSeek Harness: read-only result cache, speculative prefetch, and concurrent readonly shell commands. Honest scope: helps when tools are slow and calls repeat; model latency dominates otherwise.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./classify-command": "./lib/util/classify-command.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/util/classify-command.js",
    "cordis.patch.yml",
    "docs/BENCHMARK.md",
    "docs/evidence-0.2.2.json",
    "docs/paired-bench.json",
    "docs/paired-shell-bench.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agent",
    "tool-scheduling",
    "speculative-execution",
    "caching",
    "concurrency",
    "performance"
  ],
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJ1H/dsh-agent-speedup.git"
  },
  "homepage": "https://github.com/HJ1H/dsh-agent-speedup#readme",
  "bugs": {
    "url": "https://github.com/HJ1H/dsh-agent-speedup/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
